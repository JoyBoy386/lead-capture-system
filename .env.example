# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_key

# Meta
META_ACCESS_TOKEN=replace_with_meta_access_token
META_VERIFY_TOKEN=replace_with_meta_webhook_verify_token

# LinkedIn
LINKEDIN_ACCESS_TOKEN=replace_with_linkedin_access_token
LINKEDIN_SECRET=replace_with_linkedin_webhook_secret

# Optional local Meta mapper fallback
META_TEST_PHONE=

# Optional browser-based WhatsApp automation
WHATSAPP_ENABLED=false
WHATSAPP_WORKER_URL=http://127.0.0.1:8787
WHATSAPP_WORKER_TOKEN=replace_with_long_random_worker_token
WHATSAPP_MESSAGE_TEMPLATE=Hi {name}, thank you for your interest. We received your lead from {source}.
